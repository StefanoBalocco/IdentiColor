{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"target": "esnext",
		"types": [ "node" ],
		"module": "esnext",
		"moduleResolution": "bundler",
		"sourceMap": false,
		"declaration": false,
		"removeComments": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"allowSyntheticDefaultImports": true
	},
	"files": [
		"src/IdentiColor.test.ts"
	]
}
